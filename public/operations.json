    "library.entry.create": {
      "description": "Contribute knowledge with attributed source revisions.",
      "effect": "write",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
