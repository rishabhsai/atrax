{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://atrax.run/schema/v2.json",
  "title": "Atrax app contract v2",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 2
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,47}$"
    },
    "web": {
      "type": "object",
      "properties": {
        "assets": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*/$).+$"
        },
        "fallback": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*/$).+$"
        }
      },
      "required": [
        "assets"
      ],
      "additionalProperties": false
    },
    "actions": {
      "type": "object",
      "properties": {
        "entry": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*/$).+$"
        }
      },
      "required": [
        "entry"
      ],
      "additionalProperties": false
    },
    "tables": {
      "type": "object",
      "properties": {
        "migrations": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*/$).+$"
        }
      },
      "required": [
        "migrations"
      ],
      "additionalProperties": false
    },
    "dependencies": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{1,47}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "appId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "appId"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "name"
  ],
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "web"
      ]
    },
    {
      "required": [
        "actions"
      ]
    }
  ]
}
